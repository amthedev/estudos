# ---------------------------------------------------------------
# Foco Elite — variáveis de ambiente
# Copie para .env e preencha. Nunca versione o arquivo .env.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4100
APP_URL=http://localhost:4100
BRAND_NAME=Foco Elite

# Banco de dados (PostgreSQL 14+)
DATABASE_URL=postgres://localhost:5432/focoelite
DATABASE_URL_TEST=postgres://localhost:5432/focoelite_test
PGSSL=false

# Segurança — gere valores longos e aleatórios (ex.: openssl rand -hex 48)
JWT_SECRET=troque-este-valor
ADMIN_JWT_SECRET=troque-este-valor-tambem
COOKIE_SECURE=false

# OpenAI (usada SOMENTE no backend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ESSAY_MODEL=gpt-4o
OPENAI_MONTHLY_TOKEN_LIMIT=5000000

# Pagamentos — provedor ativo
# asaas | stripe | none. Em branco, a plataforma usa o Asaas quando ASAAS_API_KEY existir,
# senão o Stripe quando STRIPE_SECRET_KEY existir, senão fica sem checkout.
PAYMENT_PROVIDER=

# Asaas (assinaturas recorrentes em real: cartão, pix e boleto)
# Chave de API da conta (Configurações > Integrações > Chave de API no painel do Asaas).
ASAAS_API_KEY=
# sandbox = ambiente de testes (sandbox.asaas.com); qualquer outro valor = produção.
ASAAS_ENV=sandbox
# Token que o Asaas envia no cabeçalho asaas-access-token do webhook. Defina o mesmo
# valor aqui e no cadastro do webhook, apontando para APP_URL/api/billing/webhook.
ASAAS_WEBHOOK_TOKEN=

# Stripe (alternativa ao Asaas; continua funcionando quando PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# true = aluno precisa de assinatura ativa para acessar o app
REQUIRE_SUBSCRIPTION=false

# E-mail (recuperação de senha e avisos). Em desenvolvimento, sem SMTP, o link é exibido no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Foco Elite <no-reply@focoelite.com.br>"

# Primeiro administrador (usado por npm run create-admin)
ADMIN_EMAIL=admin@focoelite.com.br
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador
